import math
board = [' ' for _ in range(9)]
def print_board(board):
    for i in range(3):
        print(f" {board[i*3]} | {board[i*3+1]} | {board[i*3+2]} ")
        if i < 2:
            print("---+---+---")
    print()
def is_moves_left(board):
    return ' ' in board
def evaluate_board(board):
    win_states = [
        [0, 1, 2], [3, 4, 5], [6, 7, 8],  
        [0, 3, 6], [1, 4, 7], [2, 5, 8],  
        [0, 4, 8], [2, 4, 6]              
    ]
    for condition in win_states:
        if board[condition[0]] == board[condition[1]] == board[condition[2]]:
            if board[condition[0]] == 'O':
                return 1
            elif board[condition[0]] == 'X':
                return -1
    return 0
def minimax(board, depth, is_maximizing):
    score = evaluate_board(board)
    if score == 1 or score == -1:
        return score
    if not is_moves_left(board):
        return 0
    if is_maximizing:
        best = -math.inf
        for i in range(9):
            if board[i] == ' ':
                board[i] = 'O' 
                best = max(best, minimax(board, depth + 1, False))
                board[i] = ' ' 
        return best
    else:
        best = math.inf
        for i in range(9):
            if board[i] == ' ':
                board[i] = 'X' 
                best = min(best, minimax(board, depth + 1, True))
                board[i] = ' '  
        return best
def find_best_move(board):
    best_val = -math.inf
    best_move = -1

    for i in range(9):
        if board[i] == ' ':
            board[i] = 'O'  
            move_val = minimax(board, 0, False)
            board[i] = ' ' 
            if move_val > best_val:
                best_val = move_val
                best_move = i
    return best_move
def play_game():
    print("Welcome to Tic-Tac-Toe! You are 'X' and the AI is 'O'.")
    print("Positions are indexed from 0 to 8 (top-left to bottom-right).\n")
    print_board(board)

    while is_moves_left(board) and evaluate_board(board) == 0:
        try:
            human_move = int(input("Enter your move (0-8): "))
            if board[human_move] != ' ':
                print("Invalid move! Cell already taken. Try again.")
                continue
        except (ValueError, IndexError):
            print("Invalid input! Please enter a number between 0 and 8.")
            continue

        board[human_move] = 'X'
        print_board(board)
        if evaluate_board(board) == -1 or not is_moves_left(board):
            break
        print("AI is making a move...")
        ai_move = find_best_move(board)
        if ai_move != -1:
            board[ai_move] = 'O'
        print_board(board)
    final_score = evaluate_board(board)
    if final_score == 1:
        print("AI wins! Better luck next time.")
    elif final_score == -1:
        print("Congratulations! You won.") 
    else:
        print("It's a draw!")
if __name__ == "__main__":
   play_game()
